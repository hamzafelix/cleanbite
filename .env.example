# Copy to .env.local and fill in your key
# Create one from Command Code Studio > API keys. Needs GOAT plan or higher
# (Go plan has no API access). Usage meters against your plan credits.
CMD_API_KEY=

# Vision model for OCR (OpenAI-compatible /chat/completions).
# Must support image_url input, and must reliably terminate its reasoning:
# a model that burns the whole max_tokens budget thinking returns no JSON and
# the scan fails after minutes. deepseek-v4-flash-vision-exp does both.
# Alternatives: Qwen/Qwen3.8-Omni-Flash, google/gemini-3.8-flash
CMD_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Optional override, defaults to https://api.commandcode.ai/provider/v1
# CMD_BASE_URL=https://api.commandcode.ai/provider/v1

# Output token cap. This model is a reasoning model, so it spends a large part of
# this budget on a `reasoning` field before answering; it needs a high cap or it
# returns no JSON. Lower it if scans feel slow, but too low breaks parsing.
CMD_MAX_TOKENS=16000

# Per-request ceiling for one upstream OCR call, in ms. Prevents a stalled
# model from hanging the request. Default 90000.
# CMD_REQUEST_TIMEOUT_MS=90000
